# Copy to .dev.vars for local `wrangler dev`; never commit the real file.
# The catalog defaults are already 3.99/24.99/49.99 USD in src/catalog.js.
# Add the two Flutterwave Payment Plan IDs when testing auto-renewal.
FLW_MONTHLY_PLAN_ID=
FLW_YEARLY_PLAN_ID=

# Secrets: enter these directly in Cloudflare Worker Secrets.
FLW_SECRET_KEY=FLWSECK_TEST-replace-me
FLW_WEBHOOK_HASH=replace-with-flutterwave-secret-hash
LICENSE_PRIVATE_KEY=base64url-pkcs8-private-key

# The matching public key is for the app/client and is not a Worker secret.
ALLOWED_ORIGINS=http://localhost:5173
SUCCESS_URL=http://localhost:5173/success
DEFAULT_SCOPE=universal
GRACE_DAYS=3
